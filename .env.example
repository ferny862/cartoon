# Copy to .env and fill in. Never commit .env.
# Tiingo free tier: https://www.tiingo.com (Account > API > Token)
TIINGO_API_KEY=
# Alpaca PAPER account keys (step 6). Paper endpoint only.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Must be "true" for the paper client to start (step 6).
PAPER_TRADING=
# Optional backup source; requires a manually obtained key.
STOOQ_API_KEY=
